#include <windows.h>
#include "resource.h"

IDI_TRAYICON ICON "..\\assets\\app.ico"
IDI_WSL ICON "..\\assets\\wsl.ico"

// Asks for another Windows account's password (see account.h's OpenNewVSCodeWindowAs).
IDD_PASSWORD DIALOGEX 0, 0, 250, 94
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFOREGROUND | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "VS Code Border"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_PASSWORD_PROMPT, 7, 7, 236, 18
    EDITTEXT IDC_PASSWORD_EDIT, 7, 28, 236, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Remember the password (Windows Credential Manager)", IDC_PASSWORD_REMEMBER, 7, 50, 236, 10, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 139, 72, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 193, 72, 50, 14
END
