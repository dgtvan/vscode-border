+/* The "image/png" atom, interned once per X server (a restarted Xwayland
+ * gets a new weston_wm). Images are bridged from the Wayland selection to X11
+ * clients as this target only: it's what X11 apps (Chromium/Electron among
+ * them) ask for, and the data is passed through untouched. */
+static xcb_atom_t
+weston_wm_image_png_atom(struct weston_wm *wm)
+{
+	static struct weston_wm *cached_wm;
+	static xcb_atom_t cached_atom = XCB_ATOM_NONE;
+	xcb_intern_atom_reply_t *reply;
+
+	if (cached_wm == wm && cached_atom != XCB_ATOM_NONE)
+		return cached_atom;
+	reply = xcb_intern_atom_reply(wm->conn,
+				      xcb_intern_atom(wm->conn, 0, strlen("image/png"), "image/png"),
+				      NULL);
+	cached_atom = reply ? reply->atom : XCB_ATOM_NONE;
+	cached_wm = wm;
+	free(reply);
+	return cached_atom;
+}
+
+/* True if the current Wayland selection offers `mime_type`. */
+static bool
+weston_wm_selection_offers(struct weston_wm *wm, const char *mime_type)
+{
+	struct weston_seat *seat = weston_wm_pick_seat(wm);
+	struct weston_data_source *source;
+	char **p;
+
+	if (!seat || !(source = seat->selection_data_source))
+		return false;
+	wl_array_for_each(p, &source->mime_types) {
+		if (strcmp(*p, mime_type) == 0)
+			return true;
+	}
+	return false;
+}
